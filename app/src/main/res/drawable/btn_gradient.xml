<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:startColor="#A844FF"
                android:endColor="#8B35E0"
                android:angle="90"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:startColor="#C44CFF"
                android:endColor="#A844FF"
                android:angle="90"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
</selector>