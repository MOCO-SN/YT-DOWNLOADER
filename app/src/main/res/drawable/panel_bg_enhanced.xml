<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#1E1E2F"/>
            <corners android:radius="16dp"/>
            <stroke android:width="1dp" android:color="#3A3A4A"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:startColor="#2A2A3E"
                android:endColor="#1A1A2E"
                android:angle="45"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</layer-list>