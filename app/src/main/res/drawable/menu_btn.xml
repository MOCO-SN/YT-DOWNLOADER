<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">

        <shape>
            <solid android:color="#7E26FF"/>

            <stroke
                android:width="2dp"
                android:color="#F7A6FF"/>

            <corners android:radius="12dp"/>
        </shape>

    </item>

    <item>

        <shape>
            <solid android:color="#120018"/>

            <stroke
                android:width="2dp"
                android:color="#A020FF"/>

            <corners android:radius="12dp"/>
        </shape>

    </item>

</selector>