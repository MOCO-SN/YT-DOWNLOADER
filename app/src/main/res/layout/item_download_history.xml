<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Thumbnail Container -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="88dp"
                android:layout_height="64dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#EFEFEF"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/itemThumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_thumbnail_placeholder" />

                    <!-- Format & Quality Badge Overlay -->
                    <TextView
                        android:id="@+id/itemFormatBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="3dp"
                        android:background="#D9000000"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="1dp"
                        android:text="1080p"
                        android:textColor="@color/white"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- File Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/itemFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Video Title Here"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <!-- Location / Path where file is downloaded -->
                <TextView
                    android:id="@+id/itemFilePath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="📁 Download/YTDownloader/video"
                    android:textColor="#00B894"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="start" />

                <!-- Metadata Row (Size • Resolution • Date) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="3dp">

                    <TextView
                        android:id="@+id/itemFileSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15.2 MB"
                        android:textSize="12sp"
                        android:textColor="#7A7A7A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="•"
                        android:textColor="#7A7A7A"
                        android:layout_marginStart="4dp" />

                    <TextView
                        android:id="@+id/itemDetailResolution"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1080p FHD"
                        android:textSize="11sp"
                        android:textColor="#00B894"
                        android:textStyle="bold"
                        android:layout_marginStart="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="•"
                        android:textColor="#7A7A7A"
                        android:layout_marginStart="4dp" />

                    <TextView
                        android:id="@+id/itemFileDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nov 16, 2026"
                        android:textSize="12sp"
                        android:textColor="#7A7A7A"
                        android:layout_marginStart="4dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp" />

        <!-- Actions & Resolution Bar (Where Share and other options are available) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Resolution / Quality Badge on the left of action row -->
            <LinearLayout
                android:id="@+id/resolutionBadgeContainer"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_resolution_chip"
                android:paddingHorizontal="9dp">

                <ImageView
                    android:id="@+id/itemResolutionIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_video"
                    app:tint="#0F2B48" />

                <TextView
                    android:id="@+id/itemResolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="1080p FHD"
                    android:textColor="#0F2B48"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Spacer pushing buttons to the right -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlay"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:text="Play"
                android:textColor="#00B894"
                android:textSize="12sp"
                app:icon="@drawable/ic_play"
                app:iconTint="#00B894"
                app:iconSize="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShare"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:layout_marginStart="2dp"
                android:text="Share"
                android:textColor="#6200EE"
                android:textSize="12sp"
                app:icon="@drawable/ic_share"
                app:iconTint="#6200EE"
                app:iconSize="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:layout_marginStart="2dp"
                android:text="Delete"
                android:textColor="#E53935"
                android:textSize="12sp"
                app:icon="@drawable/ic_delete"
                app:iconTint="#E53935"
                app:iconSize="16dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
